rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function projectData(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }

    function isProjectMember(projectId) {
      return isSignedIn() && (
        request.auth.uid == projectData(projectId).ownerId ||
        request.auth.uid in projectData(projectId).memberIds
      );
    }

    function isTaskProjectMember(taskId) {
      return isProjectMember(
        get(/databases/$(database)/documents/tasks/$(taskId)).data.projectId
      );
    }

    function isNotificationRecipient() {
      return isSignedIn() && request.auth.uid == resource.data.userId;
    }

    function isNotificationRecipientOnCreate() {
      return isSignedIn() && request.auth.uid == request.resource.data.userId;
    }

    function isValidProjectNotificationCreate() {
      return isSignedIn()
        && request.resource.data.relatedProjectId is string
        && isProjectMember(request.resource.data.relatedProjectId)
        && (
          request.resource.data.userId == projectData(request.resource.data.relatedProjectId).ownerId
          || request.resource.data.userId in projectData(request.resource.data.relatedProjectId).memberIds
        );
    }

    // User profiles: authenticated users can read users (required by invite/search);
    // each user can only mutate their own profile document.
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && request.auth.uid == userId;
    }

    // Projects are visible/editable only by project members.
    match /projects/{projectId} {
      allow read: if isProjectMember(projectId);
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if isProjectMember(projectId);
    }

    // Tasks belong to a project; access inherits project membership.
    match /tasks/{taskId} {
      allow read, update, delete: if isProjectMember(resource.data.projectId);
      allow create: if isSignedIn() && isProjectMember(request.resource.data.projectId);
    }

    // Subtasks inherit access from their parent task.
    match /subtasks/{subtaskId} {
      allow read, update, delete: if isTaskProjectMember(resource.data.taskId);
      allow create: if isSignedIn() && isTaskProjectMember(request.resource.data.taskId);
    }

    // Comments inherit access from their parent task.
    match /comments/{commentId} {
      allow read, update, delete: if isTaskProjectMember(resource.data.taskId);
      allow create: if isSignedIn() && isTaskProjectMember(request.resource.data.taskId);
    }

    // Notifications are private per recipient.
    match /notifications/{notificationId} {
      allow read, update, delete: if isNotificationRecipient();
      allow create: if isNotificationRecipientOnCreate() || isValidProjectNotificationCreate();
    }

    // Project invitations are managed by project members.
    match /invitations/{invitationId} {
      allow read, update, delete: if isProjectMember(resource.data.projectId);
      allow create: if isSignedIn() && isProjectMember(request.resource.data.projectId);
    }

    // Password reset codes: Admin SDK/Cloud Functions write here, clients cannot.
    // Note: Admin SDK bypasses all Firestore rules, so explicit deny only affects client access.
    match /resetCodes/{docId} {
      allow read, write: if false;
    }

    // Deny any other path by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
